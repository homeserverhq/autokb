# Isolated development environment. Do not reuse production values here.
#
# Host view of /repos/autokb inside opencode-app. Compose interpolation reads
# this via --env-file, and bind sources must be absolute HOST paths.
AUTOKB_DEV_HOST_ROOT=/home/bolt/hshq/data/stacks/opencode/repos/autokb
AUTOKB_DEV_BIND=127.0.0.1
AUTOKB_DEV_WEB_PORT=18080
AUTOKB_DEV_MAILPIT_PORT=18083
AUTOKB_DEV_MCP_PORT=18082

POSTGRES_PASSWORD=autokbdev
POSTGRES_USER=autokbdev
POSTGRES_DB=autokbdev
MANAGER_PORT=80
WEBUI_PORT=80
MCP_PORT=80
AUTOKB_BASE_URL=http://autokb-dev-web
AUTOKB_MANAGER_URL=http://autokb-dev-manager
AUTOKB_ADMIN_USERNAME=devadmin
AUTOKB_ADMIN_PASSWORD=hwz1sPEhIYQSLAQgch5piKhR
AUTOKB_API_KEY=flkNo6EeE8QI0X3k-ViThEeZvynGle5x
AUTOKB_BACKEND_API_KEY=ZT7ahUhtjE9Gyj9Ki-zZZjM_kRnlI2Tl
AUTOKB_WEBHOOK_API_KEY=p4twjtpQTaJc8MJnDtr9UnGKbEFMmQ8b
WORKER_COUNT=2
# Faster test-runner iteration. These are dev/test-only overrides; production
# keeps the documented 300s heartbeat default.
AUTOKB_HEARTBEAT_TIMEOUT=5
AUTOKB_MONITOR_ERROR_SLEEP=2
AUTOKB_LOCK_TTL=60
AUTOKB_DEBOUNCE_PHASE_SECONDS=1
REDIS_URL=redis://autokb-dev-redis:6379/0
DATABASE_URL=postgresql://autokbdev:autokbdev@autokb-dev-db:5432/autokbdev
SMTP_HOST=autokb-dev-mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_NOTIFY_EMAIL=dev@example.invalid
SMTP_USE_TLS=False
SMTP_USE_SSL=False
ENCRYPTION_KEY=autokb-dev-only-encryption-passphrase
MAX_STARTUP_RETRIES=100
STARTUP_RETRY_SLEEP=1
LOG_LEVEL=DEBUG
